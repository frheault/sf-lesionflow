includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g) --entrypoint ""'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }
}

executor {
    name      = 'local'
    cpus      = 24
    memory    = '20.GB'
    queueSize = 4
}

manifest {
    name            = 'sf-lesionflow'
    description     = 'Reproducible Nextflow pipeline for Multiple Sclerosis lesion segmentation and longitudinal harmonization.'
    version         = '1.0.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    input        = false
    mni_template = false
    fs_license   = false
    output       = "results"
}


process {
    publishDir = { "${params.output}/${meta?.id ?: subject ?: 'pipeline_info'}/${task.process.replaceAll(':', '-')}" }

    withName: "EXPORT_SESSION" {
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}" },
            mode: 'copy'
        ]
    }

    withName: "RESAMPLE_T1" {
        ext.voxel_size   = "1.0 1.0 1.0"
        ext.first_suffix = "t1"
    }

    withName: "RESAMPLE_FLAIR" {
        ext.voxel_size   = "1.0 1.0 1.0"
        ext.first_suffix = "flair"
    }

    withName: "SYNTHSTRIP_T1" {
        ext.nocsf  = true
        ext.prefix = { "${meta.id}_t1" }
        maxForks   = 2
    }

    withName: "SYNTHSTRIP_FLAIR" {
        ext.nocsf  = true
        ext.prefix = { "${meta.id}_flair" }
        maxForks   = 2
    }

    withName: "N4_T1" {
        ext.shrink_factor = 3
        ext.prefix        = { "${meta.id}_t1" }
    }

    withName: "N4_FLAIR" {
        ext.shrink_factor = 3
        ext.prefix        = { "${meta.id}_flair" }
    }

    withName: "MASK_T1" {
        ext.prefix = { "${meta.id}_t1_masked" }
    }

    withName: "MASK_FLAIR" {
        ext.prefix = { "${meta.id}_flair_masked" }
    }

    withName: "CROP_T1_MASK" {
        ext.output_bbox  = true
        ext.first_suffix = "t1_mask"
    }

    withName: "CROP_T1_RAW" {
        ext.first_suffix = "t1_raw"
    }

    withName: "CROP_FLAIR_RAW" {
        ext.first_suffix = "flair_raw"
    }

    withName: "CROP_FLAIR_MASK" {
        ext.output_bbox  = true
        ext.first_suffix = "flair_mask"
    }

    withName: "REGISTER_FLAIR_TO_T1" {
        ext.quick     = true
        ext.transform = 'r'
        ext.prefix    = { "${meta.id}_flair_to_t1" }
    }

    withName: "REGISTER_T1_TO_BASELINE" {
        ext.quick     = true
        ext.transform = 'r'
        ext.prefix    = { "${meta.id}_t1_to_baseline" }
    }

    withName: "REGISTER_BASELINE_TO_MNI" {
        ext.quick     = true
        ext.transform = 'a'
        ext.prefix    = { "${meta.id}_baseline_to_mni" }
    }

    withName: "TRANSFORM_T1W_TO_MNI" {
        ext.prefix = { "${meta.id}_t1_masked_space-MNI" }
    }

    withName: "TRANSFORM_FLAIR_TO_MNI" {
        ext.prefix = { "${meta.id}_flair_masked_space-MNI" }
    }

    withName: "TRANSFORM_T1W_UNSTRIPPED_TO_MNI" {
        ext.prefix = { "${meta.id}_t1_unstripped_space-MNI" }
    }

    withName: "TRANSFORM_FLAIR_UNSTRIPPED_TO_MNI" {
        ext.prefix = { "${meta.id}_flair_unstripped_space-MNI" }
    }

    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        maxForks = 2
    }

    withName: "SEGMENTATION_SAMSEG" {
        maxForks = 2
    }

    withName: "SEGMENTATION_EMORY_ROBUST" {
        maxForks = 1
    }
}
