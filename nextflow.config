def _algo_file = new File("${projectDir}/lib/AlgorithmSelection.groovy")
if (!_algo_file.exists()) {
    _algo_file = new File("lib/AlgorithmSelection.groovy")
}
if (_algo_file.exists()) {
    AlgorithmSelection = new GroovyClassLoader(getClass().getClassLoader()).parseClass(_algo_file)
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp --entrypoint ""'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }
    local_dev {
        includeConfig 'conf/local_dev.config'
    }
}

manifest {
    name            = 'sf-lesionflow'
    description     = 'Reproducible Nextflow pipeline for Multiple Sclerosis lesion segmentation and longitudinal harmonization.'
    version         = '1.0.0'
    nextflowVersion = '!>=24.04.0'
}

// NOTE: env{} and process.shell overrides (PYTHONNOUSERSITE, OPENBLAS_NUM_THREADS,
// strict bash flags) were deliberately held back here -- both are GLOBAL process
// directives that would invalidate the -resume cache hash for every already-completed
// task in the pipeline, not just new ones. Apply them in a dedicated run where a full
// recompute is acceptable, not bundled into an unrelated single-process fix.

params {
    input             = false
    mni_template      = false
    fs_license        = false
    participant_label = false
    output            = "results"
    algorithms        = false
    skip_algorithms   = false
    max_memory        = false
}


process {
    publishDir = { "${params.output}/${meta?.id ?: subject ?: 'pipeline_info'}/${task.process.replaceAll(':', '-')}" }

    withName: "CONSENSUS_STAPLE" {
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}/${meta.session ?: 'ses-single'}/staple_classical" },
            mode: 'copy',
            pattern: '*.nii.gz'
        ]
    }

    withName: "HARMONIZATION_STAPLE" {
        publishDir = [
            path: { "${params.output}/final_outputs/${subject}" },
            mode: 'copy'
        ]
    }

    withName: "RESAMPLE_T1" {
        ext.voxel_size   = "1.0 1.0 1.0"
        ext.first_suffix = "t1"
    }

    withName: "RESAMPLE_FLAIR" {
        ext.voxel_size   = "1.0 1.0 1.0"
        ext.first_suffix = "flair"
    }

    withName: "SYNTHSTRIP_T1" {
        ext.nocsf  = true
        ext.prefix = { "${meta.id}_t1" }
        maxForks   = 2
    }

    withName: "SYNTHSTRIP_FLAIR" {
        ext.nocsf  = true
        ext.prefix = { "${meta.id}_flair" }
        maxForks   = 2
    }

    withName: "N4_T1" {
        ext.shrink_factor = 3
        ext.prefix        = { "${meta.id}_t1" }
    }

    withName: "N4_FLAIR" {
        ext.shrink_factor = 3
        ext.prefix        = { "${meta.id}_flair" }
    }

    withName: "MASK_T1" {
        ext.prefix = { "${meta.id}_t1" }
    }

    withName: "MASK_FLAIR" {
        ext.prefix = { "${meta.id}_flair" }
    }

    withName: "CROP_T1_MASK" {
        ext.output_bbox  = true
        ext.first_suffix = "t1_mask"
    }

    withName: "CROP_T1_RAW" {
        ext.first_suffix = "t1_raw"
    }

    withName: "CROP_FLAIR_RAW" {
        ext.first_suffix = "flair_raw"
    }

    withName: "CROP_FLAIR_MASK" {
        ext.output_bbox  = true
        ext.first_suffix = "flair_mask"
    }

    withName: "REGISTER_FLAIR_TO_T1" {
        ext.quick     = true
        ext.transform = 'r'
        ext.prefix    = { "${meta.id}_flair_to_t1" }
    }

    withName: "REGISTER_T1_TO_BASELINE" {
        ext.quick     = true
        ext.transform = 'r'
        ext.prefix    = { "${meta.id}_t1_to_baseline" }
    }

    withName: "REGISTER_BASELINE_TO_MNI" {
        ext.quick     = true
        ext.transform = 'a'
        ext.prefix    = { "${meta.id}_baseline_to_mni" }
    }

    withName: "TRANSFORM_T1W_TO_MNI" {
        ext.prefix = { "${meta.id}_t1" }
        ext.suffix = "space-MNI"
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}/${meta.session ?: 'ses-single'}" },
            mode: 'copy',
            pattern: '*.nii.gz'
        ]
    }

    withName: "TRANSFORM_FLAIR_TO_MNI" {
        ext.prefix = { "${meta.id}_flair" }
        ext.suffix = "space-MNI"
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}/${meta.session ?: 'ses-single'}" },
            mode: 'copy',
            pattern: '*.nii.gz'
        ]
    }

    withName: "TRANSFORM_T1W_UNSTRIPPED_TO_MNI" {
        ext.prefix = { "${meta.id}_t1" }
        ext.suffix = "unstripped_space-MNI"
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}/${meta.session ?: 'ses-single'}" },
            mode: 'copy',
            pattern: '*.nii.gz'
        ]
    }

    withName: "TRANSFORM_FLAIR_UNSTRIPPED_TO_MNI" {
        ext.prefix = { "${meta.id}_flair" }
        ext.suffix = "unstripped_space-MNI"
        publishDir = [
            path: { "${params.output}/final_outputs/${meta.subject}/${meta.session ?: 'ses-single'}" },
            mode: 'copy',
            pattern: '*.nii.gz'
        ]
    }

    withName: "SEGMENTATION_LST_AI" {
        ext.when = { AlgorithmSelection.isActive('lst_ai', params) }
    }

    withName: "SEGMENTATION_SAMSEG" {
        maxForks = 2
        ext.when = { AlgorithmSelection.isActive('samseg', params) }
    }

    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        maxForks = 2
        // mri_WMHsynthseg is a MATLAB-compiled binary that writes its runtime
        // startup file to $HOME/matlab/ -- the global HOME=/tmp override (set
        // for unrelated container-permission reasons) makes it try to write to
        // /tmp/matlab/ and fail silently. Redirect HOME to this task's own work
        // directory instead: guaranteed writable, unique per task.
        containerOptions = { "-e HOME=${task.workDir}" }
        ext.when = { AlgorithmSelection.isActive('wmh_synthseg', params) }
    }

    withName: "SEGMENTATION_FAST_OUTLIER" {
        ext.when = { AlgorithmSelection.isActive('fast_outlier', params) }
    }

    withName: "SEGMENTATION_FLAMES" {
        ext.when = { AlgorithmSelection.isActive('flames', params) }
    }

    withName: "SEGMENTATION_TRUENET" {
        ext.when = { AlgorithmSelection.isActive('truenet', params) }
    }

    withName: "SEGMENTATION_HYPERMAPP3R" {
        // hypermapper's own cosmetic sign-off print calls pwd.getpwuid(os.getuid()),
        // which hard-crashes (KeyError) because the arbitrary Docker UID has no
        // /etc/passwd entry inside the container -- this happens AFTER the real
        // segmentation already succeeded. Bind-mount the host's own /etc/passwd
        // (read-only), which does have a real entry for this UID, instead of
        // running as root (would reintroduce root-owned output files).
        containerOptions = '-v /etc/passwd:/etc/passwd:ro'
        ext.when = { AlgorithmSelection.isActive('hypermapp3r', params) }
    }

    withName: "SEGMENTATION_SEGCSVD" {
        ext.when = { AlgorithmSelection.isActive('segcsvd', params) }
    }

    withName: "SEGMENTATION_EMORY_ROBUST" {
        maxForks = 2
        ext.when = { AlgorithmSelection.isActive('emory_robust', params) }
    }

    withName: "SEGMENTATION_MARS_WMH" {
        ext.when = { AlgorithmSelection.isActive('mars_wmh', params) }
    }

    withName: "SEGMENTATION_BAWIL" {
        ext.when = { AlgorithmSelection.isActive('bawil', params) }
    }

    withName: "SEGMENTATION_MIMOSA" {
        ext.when = { AlgorithmSelection.isActive('mimosa', params) }
    }

    withName: "SEGMENTATION_SHIVAI" {
        ext.when = { AlgorithmSelection.isActive('shivai', params) }
    }
}
