nextflow_pipeline {
    name "Test MS Lesion WMH Pipeline"
    script "main.nf"

    test("Stub-run wires the full DAG without errors") {
        options "-stub-run -profile stub"
        when {
            params {
                input        = "data"
                mni_template = "template/mni_masked.nii.gz"
                fs_license   = "${projectDir}/tests/data/fs_license.txt"
                output       = "results_test"
            }
        }
        then {
            assert workflow.success
            def ses = "${params.output}/sub-007/ses-1"
            assert file("${ses}/anat/sub-007_ses-1_space-MNI_desc-brain_mask.nii.gz").exists()
            assert file("${ses}/lesions").list().findAll { it.endsWith('_mask.nii.gz') }.size() == 12
            assert file("${ses}/consensus/sub-007_ses-1_space-MNI_desc-staple_mask.nii.gz").exists()
            assert file("${params.output}/sub-007/longitudinal/sub-007_space-MNI_desc-lesiontracking.csv").exists()
            assert file("${params.output}/pipeline_info/software_versions.yml").exists()
            assert !file("${params.output}/sub-007/ses-single").exists()
        }
    }

    test("Full Pipeline Execution with Single Subject") {
        tag "full_execution"
        when {
            params {
                input        = "data"
                mni_template = "template/mni_masked.nii.gz"
                fs_license   = "${projectDir}/tests/data/fs_license.txt"
                output       = "results_test"
            }
        }
        then {
            assert workflow.success
            assert file("${params.output}/sub-007/longitudinal/sub-007_space-MNI_desc-lesiontracking.csv").exists()
        }
    }
}
