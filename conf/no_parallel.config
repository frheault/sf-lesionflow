// Fully serial execution: at most ONE task runs at any time, pipeline-wide.
// Use on memory-bound hosts where two heavy tasks (e.g. WMH-SynthSeg on CPU,
// ~28 GB peak, alongside anything else) cannot coexist:
//   -profile docker,local_dev,no_parallel
// executor.queueSize is the single global limit the executor enforces across
// all processes (per-process maxForks only caps instances of one process).
// Declared after local_dev in nextflow.config so it overrides its queueSize = 2.

executor {
    queueSize = 1
}

process {
    maxForks = 1
}
