// =============================================================================
// Base Process Configuration (Universal Resource Baseline)
// Single source of truth for process resources (CPU, Memory, Time).
// Applies universally across all execution environments (HPC, local, cloud).
//
// Every process below is sized individually for what that specific tool does
// (threading model, GPU-capability, measured runtime) -- there is no generic
// resource "tier" to fall back on. A process with no explicit block here gets
// only the bare-minimum default just below (1 cpu / 4GB / 1h) until it has
// been profiled and given its own entry.
// =============================================================================

process {
    cpus   = { 1 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in [143,137,104,134,135,139,140,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // -------------------------------------------------------------------------
    // GPU request mechanism (not a resource tier -- shared, identical wiring
    // for every GPU-capable process; cpus/memory/time are set per-process below)
    // -------------------------------------------------------------------------
    withLabel: 'process_gpu' {
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }

    // -------------------------------------------------------------------------
    // Per-Process Resource Allocations
    // -------------------------------------------------------------------------

    // scilpy scil_volume_resample: no internal threading
    withName: "RESAMPLE_T1|RESAMPLE_FLAIR" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // scilpy scil_volume_crop: no internal threading
    withName: "CROP_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // MRtrix mrcalc: single voxelwise op, trivial footprint
    withName: "MASK_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // ITK antsApplyTransforms (+ optional QC screenshot branch): ITK-multithread
    // capable but empirically fast; revisit time budget if profiling disagrees.
    withName: "TRANSFORM_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // ITK/MRtrix N4 bias correction: threads scale with task.cpus (ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS)
    // Empirically measured ~185 MB peak RSS; 4 GB provides ample safety margin.
    withName: "N4_T1|N4_FLAIR" {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 45.m * task.attempt }
    }

    // ANTs SyN registration (antsRegistrationSyN[Quick].sh): threads scale with task.cpus.
    // Empirically measured ~270-560 MB peak RSS; 4 GB provides ample safety margin.
    withName: "REGISTER_FLAIR_TO_T1|REGISTER_T1_TO_BASELINE|REGISTER_BASELINE_TO_MNI" {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 45.m * task.attempt }
    }

    // SynthStrip: GPU (~30s) vs 4-CPU fallback (~15s); threads scale with task.cpus on CPU path.
    // Empirically measured 5.70 GB peak RSS on CPU path -- bumped to 8 GB for safety headroom.
    withName: "SYNTHSTRIP_T1|SYNTHSTRIP_FLAIR" {
        ext.gpu        = { params.use_gpu }
        cpus           = { task.ext.gpu ? 2 : 4 }
        memory         = { 8.GB * task.attempt }
        time           = { (task.ext.gpu ? 10.m : 30.m) * task.attempt }
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }

    // WMH-SynthSeg: single-threaded on CPU (--threads 1, 97% CPU empirical, ~7.7m).
    // Empirically measured 27.97 GB peak RSS -- 32 GB guarantees 100% first-attempt success.
    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        cpus   = { task.ext.gpu ? 2 : 1 }
        memory = { (task.ext.gpu ? 16.GB : 32.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 25.m) * task.attempt }
    }

    // FLAMeS (nnU-Net v2): forced CPU-only -- published image has CPU torch.
    // Empirically measured 5.82 GB peak RSS, 3.1m runtime -- 8 GB is optimal.
    withName: "SEGMENTATION_FLAMES" {
        cpus          = 4
        memory        = { 8.GB * task.attempt }
        time          = { 15.m * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // TrueNet: empirically measured 948 MB peak RSS, 1.5m runtime.
    // 4 GB on CPU provides 4x safety margin over measured peak.
    withName: "SEGMENTATION_TRUENET" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 8.GB : 4.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 15.m) * task.attempt }
    }

    // SegCSVD: empirically measured 1.78 GB peak RSS, 4.5m runtime.
    // 4 GB on CPU provides 2.2x safety margin over measured peak.
    withName: "SEGMENTATION_SEGCSVD" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 8.GB : 4.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 20.m) * task.attempt }
    }

    // Emory Robust WMH (nnU-Net): empirically measured 8.47 GB peak RSS, ~24m runtime.
    // 12 GB on CPU provides safe headroom.
    withName: "SEGMENTATION_EMORY_ROBUST" {
        cpus          = { task.ext.gpu ? 2 : 4 }
        memory        = { (task.ext.gpu ? 8.GB : 12.GB) * task.attempt }
        time          = { (task.ext.gpu ? 10.m : 40.m) * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // MARS-WMH (nnU-Net): empirically measured 5.81 GB peak RSS, ~20m runtime.
    // 8 GB on CPU provides safe headroom.
    withName: "SEGMENTATION_MARS_WMH" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 8.GB : 8.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
    }

    // LST-AI: GPU-capable (dockerfiles/lst_ai now installs a CUDA torch wheel +
    // tensorflow[and-cuda]); OMP_NUM_THREADS/--threads scale with task.cpus on
    // CPU. GPU-path values are an initial estimate, not yet profiled on real
    // GPU hardware -- check trace data once available.
    withName: "SEGMENTATION_LST_AI" {
        cpus   = { task.ext.gpu ? 2 : 6 }
        memory = { (task.ext.gpu ? 8.GB : 10.GB) * task.attempt }
        time   = { (task.ext.gpu ? 15.m : 45.m) * task.attempt }
    }

    // HyperMapp3r: Theano/TF1.5 whole-volume (unpatched) 3D inference.
    // Empirically measured 23.13 GB peak RSS (max 28.90 GB across large brains).
    // Bumped to 30 GB to ensure 100% first-pass completion; runtime is ~48 seconds.
    withName: "SEGMENTATION_HYPERMAPP3R" {
        cpus          = 2
        memory        = { 30.GB * task.attempt }
        time          = { 15.m * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // SHiVAi: empirically measured 4.04 GB peak RSS, 1.3m runtime.
    // 6 GB provides safe headroom.
    withName: "SEGMENTATION_SHIVAI" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { 6.GB * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 15.m) * task.attempt }
    }

    // BAWIL: empirically measured 981 MB peak RSS, 1.4m runtime.
    // 4 GB provides 4x safety margin over measured peak.
    withName: "SEGMENTATION_BAWIL" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 4.GB : 4.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 15.m) * task.attempt }
    }

    // MIMoSA: structurally single-threaded R script; empirically measured 5.91 GB peak RSS, 3.6m runtime.
    // 8 GB provides comfortable headroom over the 6.7 GB cohort maximum.
    withName: "SEGMENTATION_MIMOSA" {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 20.m * task.attempt }
    }

    // Fast outlier heuristic (FSL fast + pure-Python z-score threshold): runtime ~2.5m, peak RSS ~911 MB.
    withName: "SEGMENTATION_FAST_OUTLIER" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // SAMSEG: FreeSurfer run_samseg --threads task.cpus.
    // Empirically measured 10.36 GB peak RSS (max 11.5 GB), 13.8m runtime across 8 CPUs.
    // 16 GB provides ample safety margin.
    withName: "SEGMENTATION_SAMSEG" {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    // STAPLE Consensus Fusion: SimpleITK STAPLEImageFilter.
    // Empirically measured 580 MB peak RSS, ~20s runtime.
    withName: "CONSENSUS_STAPLE" {
        cpus   = 2
        memory = { 3.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    // Longitudinal Harmonization: pure NumPy/pandas, single-threaded.
    withName: "HARMONIZATION_STAPLE" {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // QC reports: lightweight single-threaded Python/matplotlib/MultiQC steps
    withName: ".*QC_ENSEMBLE_METRICS|.*QC_LONGITUDINAL|.*QC_REGISTRATION_FLAIR_T1|.*QC_REGISTRATION_T1_BASELINE|.*QC_REGISTRATION_BASELINE_MNI|.*QC_LESION_SCREENSHOT|.*MULTIQC_SUBJECT|.*MULTIQC_GLOBAL" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }
}
