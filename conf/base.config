// =============================================================================
// Base Process Configuration (Universal Resource Baseline)
// Single source of truth for process resources (CPU, Memory, Time).
// Applies universally across all execution environments (HPC, local, cloud).
//
// Every process below is sized individually for what that specific tool does
// (threading model, GPU-capability, measured runtime) -- there is no generic
// resource "tier" to fall back on. A process with no explicit block here gets
// only the bare-minimum default just below (1 cpu / 4GB / 1h) until it has
// been profiled and given its own entry.
// =============================================================================

process {
    cpus   = { 1 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in [143,137,104,134,135,139,140,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // -------------------------------------------------------------------------
    // GPU request mechanism (not a resource tier -- shared, identical wiring
    // for every GPU-capable process; cpus/memory/time are set per-process below)
    // -------------------------------------------------------------------------
    withLabel: 'process_gpu' {
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }

    // -------------------------------------------------------------------------
    // Per-Process Resource Allocations
    // -------------------------------------------------------------------------

    // scilpy scil_volume_resample: no internal threading
    withName: "RESAMPLE_T1|RESAMPLE_FLAIR" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // scilpy scil_volume_crop: no internal threading
    withName: "CROP_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // MRtrix mrcalc: single voxelwise op, trivial footprint
    withName: "MASK_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // ITK antsApplyTransforms (+ optional QC screenshot branch): ITK-multithread
    // capable but empirically fast; revisit time budget if profiling disagrees.
    withName: "TRANSFORM_.*" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // ITK/MRtrix N4 bias correction: threads scale with task.cpus (ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS)
    withName: "N4_T1|N4_FLAIR" {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 45.m * task.attempt }
    }

    // ANTs SyN registration (antsRegistrationSyN[Quick].sh): threads scale with task.cpus.
    // Time budget carried over from the old shared N4 block -- unverified for this
    // tool specifically; full SyN is typically slower than N4, check trace data.
    withName: "REGISTER_FLAIR_TO_T1|REGISTER_T1_TO_BASELINE|REGISTER_BASELINE_TO_MNI" {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 45.m * task.attempt }
    }

    // SynthStrip: GPU (~30s) vs 4-CPU fallback (~3m); threads scale with task.cpus on CPU path
    withName: "SYNTHSTRIP_T1|SYNTHSTRIP_FLAIR" {
        ext.gpu        = { params.use_gpu }
        cpus           = { task.ext.gpu ? 2 : 4 }
        memory         = { (task.ext.gpu ? 8.GB : 6.GB) * task.attempt }
        time           = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }

    // WMH-SynthSeg: single-threaded on CPU (--threads 1, 102% CPU empirical, ~20-25m);
    // on GPU path allocate 2 cpus for the host-to-device pipeline (~30-60s)
    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        cpus   = { task.ext.gpu ? 2 : 1 }
        memory = { (task.ext.gpu ? 16.GB : 24.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 1.h) * task.attempt }
    }

    // FLAMeS (nnU-Net v2): forced CPU-only -- the published image has no CUDA-enabled
    // torch (see dockerfiles/flames/Dockerfile), so this never requests a GPU.
    // No thread cap set in-script -- cpus is unverified, check trace data.
    withName: "SEGMENTATION_FLAMES" {
        cpus          = 4
        memory        = { 16.GB * task.attempt }
        time          = { 45.m * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // TrueNet: no thread cap set in-script -- CPU-path cpus is unverified,
    // check trace data before trusting it. GPU request comes from the shared
    // 'process_gpu' label.
    withName: "SEGMENTATION_TRUENET" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 12.GB : 16.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
    }

    // SegCSVD: OMP_NUM_THREADS=task.cpus on the CPU path -- expected to behave.
    // GPU request comes from the shared 'process_gpu' label.
    withName: "SEGMENTATION_SEGCSVD" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 12.GB : 16.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
    }

    // Emory Robust WMH (nnU-Net): OMP_NUM_THREADS is hardcoded to 4 in-script,
    // so cpus must move in lockstep with the script if it's ever changed.
    // GPU request comes from the shared 'process_gpu' label.
    withName: "SEGMENTATION_EMORY_ROBUST" {
        cpus          = { task.ext.gpu ? 2 : 4 }
        memory        = { (task.ext.gpu ? 12.GB : 16.GB) * task.attempt }
        time          = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // MARS-WMH (nnU-Net): OMP_NUM_THREADS=task.cpus -- expected to behave.
    // GPU request comes from the shared 'process_gpu' label.
    withName: "SEGMENTATION_MARS_WMH" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 12.GB : 16.GB) * task.attempt }
        time   = { (task.ext.gpu ? 10.m : 45.m) * task.attempt }
    }

    // LST-AI: GPU-capable (dockerfiles/lst_ai now installs a CUDA torch wheel +
    // tensorflow[and-cuda]); OMP_NUM_THREADS/--threads scale with task.cpus on
    // CPU. GPU-path values are an initial estimate, not yet profiled on real
    // GPU hardware -- check trace data once available.
    withName: "SEGMENTATION_LST_AI" {
        cpus   = { task.ext.gpu ? 2 : 6 }
        memory = { (task.ext.gpu ? 8.GB : 10.GB) * task.attempt }
        time   = { (task.ext.gpu ? 15.m : 45.m) * task.attempt }
    }

    // HyperMapp3r: hardcodes OMP/OPENBLAS/MKL_NUM_THREADS=2 -- cannot use more
    // than 2 threads, so cpus is capped to match (was 4, wasting 2 cores/job).
    // Theano/TF1.5 whole-volume (unpatched) 3D inference; documented ~16.2GB
    // peak, but observed OOM-killed at 20GB on a real subject (2026-09-17) --
    // bumped to 24GB for headroom. The script now explicitly propagates the
    // subshell's exit code so an OOM-kill here reliably triggers Nextflow's
    // retry-with-more-memory (24 -> 48 -> 72GB across attempts).
    withName: "SEGMENTATION_HYPERMAPP3R" {
        cpus          = 2
        memory        = { 24.GB * task.attempt }
        time          = { 45.m * task.attempt }
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 135, 139, 140, 247] ? 'retry' : 'finish' }
    }

    // SHiVAi: TF SavedModel, GPU-capable (dockerfiles/shivai now installs
    // tensorflow[and-cuda] -- not yet rebuilt/verified, see Dockerfile note),
    // no thread cap set anywhere on CPU -- cpus is unverified, check trace
    // data. GPU-path values are an initial estimate pending real profiling.
    withName: "SEGMENTATION_SHIVAI" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { 10.GB * task.attempt }
        time   = { (task.ext.gpu ? 20.m : 45.m) * task.attempt }
    }

    // BAWIL: Keras/TF, GPU-capable (dockerfiles/bawil now installs
    // tensorflow[and-cuda]), no thread cap set anywhere on CPU -- cpus is
    // unverified, check trace data. GPU-path values are an initial estimate
    // pending real profiling.
    withName: "SEGMENTATION_BAWIL" {
        cpus   = { task.ext.gpu ? 2 : 4 }
        memory = { (task.ext.gpu ? 8.GB : 10.GB) * task.attempt }
        time   = { (task.ext.gpu ? 15.m : 45.m) * task.attempt }
    }

    // MIMoSA: plain R script, hardcodes cores = 1 in mimosa_data() -- structurally
    // single-threaded, so cpus is capped to match (was 4, wasting 3 cores/job).
    // Memory left at 10GB pending a trace check -- likely over-provisioned for a
    // single-volume GLM predict, but no measured data yet to justify a lower number.
    withName: "SEGMENTATION_MIMOSA" {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = { 45.m * task.attempt }
    }

    // Fast outlier heuristic (FSL fast + pure-Python z-score threshold): runtime ~1m
    withName: "SEGMENTATION_FAST_OUTLIER" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }

    // SAMSEG: FreeSurfer run_samseg --threads task.cpus, scales with OpenMP
    // threads during EM atlas fitting; 8 cpus halves runtime to ~10-15m
    withName: "SEGMENTATION_SAMSEG" {
        cpus   = 8
        memory = { 20.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // STAPLE Consensus Fusion: SimpleITK STAPLEImageFilter/resample, no thread
    // cap set anywhere -- cpus is unverified, check trace data.
    withName: "CONSENSUS_STAPLE" {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    // Longitudinal Harmonization: pure NumPy/pandas, single-threaded -- likely
    // over-provisioned at 2 cpus, pending a trace check.
    withName: "HARMONIZATION_STAPLE" {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    // QC reports: lightweight single-threaded Python/matplotlib/MultiQC steps
    withName: ".*QC_ENSEMBLE_METRICS|.*QC_LONGITUDINAL|.*QC_REGISTRATION_FLAIR_T1|.*QC_REGISTRATION_T1_BASELINE|.*QC_REGISTRATION_BASELINE_MNI|.*QC_LESION_SCREENSHOT|.*MULTIQC_SUBJECT|.*MULTIQC_GLOBAL" {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.m * task.attempt }
    }
}
