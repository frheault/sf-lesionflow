// Resource profile for small single-machine dev/test hosts (e.g. ~31GB RAM, 1 CPU core).
// Unlike conf/base.config, memory here is fixed per attempt, not scaled by task.attempt --
// on a fixed-size host, retrying with more memory than the machine has can never succeed.

executor {
    name      = 'local'
    cpus      = 24
    memory    = '20.GB'
    queueSize = 2
}

process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = '4.GB'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = '6.GB'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8.GB'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '10.GB'
    }
    withLabel: 'process_high_memory' {
        cpus   = 4
        memory = '16.GB'
    }

    withName: "SEGMENTATION_WMH_SYNTHSEG|SEGMENTATION_SAMSEG|SEGMENTATION_EMORY_ROBUST" {
        maxForks = 1
        memory   = '16.GB'
    }
}
