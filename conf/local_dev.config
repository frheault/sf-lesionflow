// Resource profile for small single-machine dev/test hosts (e.g. ~31GB RAM, 1 CPU core).
// Unlike conf/base.config, memory here is fixed per attempt, not scaled by task.attempt --
// on a fixed-size host, retrying with more memory than the machine has can never succeed.

executor {
    name      = 'local'
    cpus      = 24
    memory    = '24.GB'
    queueSize = 2
}

process {
    // Retries mitigate transient GPU/VRAM or RAM contention spikes between concurrent tasks
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2


    withLabel: 'process_single' {
        cpus   = 1
        memory = '4.GB'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = '6.GB'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8.GB'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '12.GB'
    }
    withLabel: 'process_high_memory' {
        cpus   = 4
        memory = '16.GB'
    }
    withLabel: 'process_gpu' {
        maxForks = 1
    }

    withName: "SYNTHSTRIP_T1|SYNTHSTRIP_FLAIR" {
        ext.gpu  = false
        maxForks = 2
    }

    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        maxForks = 1
        memory   = '20.GB'
        // Empirical benchmark on 8GB host GPU (RTX 3070 Ti) confirmed mri_WMHsynthseg
        // requires ~9-10 GB VRAM, triggering CUDA OOM when sharing VRAM with Xorg.
        // Keep on CPU for local_dev profile; HPC runs with >=16GB VRAM will use GPU.
        ext.gpu  = false
    }

    withName: "SEGMENTATION_SAMSEG|SEGMENTATION_EMORY_ROBUST|SEGMENTATION_HYPERMAPP3R" {
        maxForks = 1
        memory   = '16.GB'
    }

    withName: "SEGMENTATION_MIMOSA" {
        cpus   = 1
        memory = '8.GB'
    }

    withName: "SEGMENTATION_FLAMES" {
        memory = '10.GB'
    }

    withName: "SEGMENTATION_LST_AI" {
        memory = '10.GB'
    }
}
