// Resource profile for small single-machine dev/test hosts (e.g. ~31GB RAM, 1 CPU core).
// Unlike conf/base.config, memory here is generally fixed per attempt, not scaled by
// task.attempt -- on a fixed-size host, retrying with more memory than the machine has
// can never succeed. SEGMENTATION_WMH_SYNTHSEG is the one deliberate exception: see its
// own comment below for why it scales within this host's actual ceiling instead.

executor {
    name      = 'local'
    cpus      = 24
    // Real host total is ~31 GB; declared as 28 GB (not 31) to leave headroom for the
    // OS/desktop, and because SEGMENTATION_WMH_SYNTHSEG's memory now scales up to 30 GB
    // on retry (see below) -- this executor ceiling must be >= that, or the local
    // executor's own scheduling math understates what a single task can legitimately
    // request, risking it double-booking a second concurrent task (queueSize below)
    // into memory WMH-SynthSeg actually needs.
    memory    = '28.GB'
    queueSize = 2
}

process {
    // Retries mitigate transient GPU/VRAM or RAM contention spikes between concurrent tasks
    errorStrategy = { task.exitStatus in [143,137,104,134,135,139,140,247] ? 'retry' : 'finish' }
    maxRetries    = 2


    withLabel: 'process_gpu' {
        maxForks = 1
    }

    withName: "SYNTHSTRIP_T1|SYNTHSTRIP_FLAIR" {
        ext.gpu  = false
        maxForks = 2
    }

    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        maxForks = 1
        // Scaled by task.attempt, unlike every other process in this file: CPU-path peak
        // RSS is empirically ~28 GB (see conf/base.config), so the previous fixed 20 GB
        // cap OOM-killed deterministically every attempt (confirmed: exit 137, "Killed").
        // This host has ~31 GB total RAM, so scale within that real ceiling rather than
        // repeat a doomed value 3x: 24 GB -> 28 GB -> 30 GB. The final attempt leaves
        // only ~1 GB of headroom for the OS/Docker daemon -- if it still OOMs, the actual
        // fix is running this process on GPU (16 GB, far more comfortable -- see ext.gpu
        // below, currently forced off by the host's broken NVIDIA driver) or
        // --skip_algorithms wmh_synthseg, not pushing this number any higher.
        memory   = { [24.GB, 28.GB, 30.GB][task.attempt - 1] }
        // Empirical benchmark on 8GB host GPU (RTX 3070 Ti) confirmed mri_WMHsynthseg
        // requires ~9-10 GB VRAM, triggering CUDA OOM when sharing VRAM with Xorg.
        // Keep on CPU for local_dev profile; HPC runs with >=16GB VRAM will use GPU.
        ext.gpu  = false
    }

    withName: "SEGMENTATION_SAMSEG|SEGMENTATION_EMORY_ROBUST|PREPROC_SYNTHSEG" {
        maxForks = 1
        memory   = '16.GB'
    }

    withName: "SEGMENTATION_HYPERMAPP3R" {
        maxForks = 1
        // Scaled by task.attempt, same reasoning/pattern as SEGMENTATION_WMH_SYNTHSEG
        // above: this was a flat 16 GB (shared with SAMSEG/Emory Robust) until
        // mc_samples went from 1->20 (see modules/local/lesion_segmentation.nf --
        // HyperMapp3r's validated accuracy is the MEAN of 20 MC-dropout passes, not a
        // single deterministic one). Confirmed by a real failure on this host: exit 137
        // at n=20 with the old flat 16 GB cap. conf/base.config's own empirical note
        // already measured up to 28.9 GB peak RSS at the OLD n=1 default -- n=20 very
        // plausibly needs more than that (accumulating 20 full-volume probability
        // arrays before averaging), which may exceed what this ~31 GB host can give it
        // at all. Scale within the same real ceiling used for WMH-SynthSeg (24 -> 28 ->
        // 30 GB) as the best available option; if it still OOMs at 30 GB on the final
        // attempt, that's this host genuinely unable to run the corrected mc_samples=20
        // configuration -- the fix is `--skip_algorithms hypermapp3r` on this workstation
        // or running it on a host/HPC node with more RAM, not pushing this number further.
        memory   = { [24.GB, 28.GB, 30.GB][task.attempt - 1] }
    }

    withName: "SEGMENTATION_MARS_WMH" {
        maxForks = 1
        memory   = '12.GB'
    }

    withName: "SEGMENTATION_MIMOSA" {
        cpus   = 1
        memory = '8.GB'
    }

    withName: "SEGMENTATION_FLAMES" {
        memory = '10.GB'
    }

    withName: "SEGMENTATION_LST_AI" {
        memory = '10.GB'
    }
}
