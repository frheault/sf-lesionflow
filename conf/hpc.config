// =============================================================================
// HPC Profile for Slurm & Shared Supercomputing Clusters
// Optimized for Alliance Canada (Beluga, Narval, Graham), NIH HPC (Biowulf),
// and institutional Slurm clusters running Apptainer/Singularity with GPUs.
// Process resource allocations (CPUs, RAM, Time) are inherited from
// conf/base.config as a single universal source of truth.
// =============================================================================

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    // Lenient caching accommodates Lustre / GPFS distributed filesystem timestamp jitter
    cache         = 'lenient'
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Concurrency throttling for memory-intensive segmentation algorithms
    // to prevent cluster node exhaustion and mass concurrent OOM kills.
    withName: "SEGMENTATION_SAMSEG|SEGMENTATION_EMORY_ROBUST|SEGMENTATION_HYPERMAPP3R|SEGMENTATION_WMH_SYNTHSEG" {
        maxForks = params.max_forks ? params.max_forks.toInteger() : 2
    }

    withName: "SEGMENTATION_FLAMES|SEGMENTATION_LST_AI" {
        maxForks = params.max_forks ? params.max_forks.toInteger() : 4
    }

    withName: "SEGMENTATION_HYPERMAPP3R" {
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    }

    withName: "SEGMENTATION_EMORY_ROBUST" {
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    }
}

