// =============================================================================
// HPC Profile for Slurm & Shared Supercomputing Clusters
// Optimized for Alliance Canada (Beluga, Narval, Graham), NIH HPC (Biowulf),
// and institutional Slurm clusters running Apptainer/Singularity with GPUs.
// =============================================================================

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    // Lenient caching accommodates Lustre / GPFS distributed filesystem timestamp jitter
    cache         = 'lenient'
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries    = 2

    // -------------------------------------------------------------------------
    // Baseline HPC Tiers (Scalable per Task Attempt)
    // -------------------------------------------------------------------------
    withLabel: 'process_single' {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 6.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = { 8 * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: 'process_gpu' {
        cpus           = { 4 }
        memory         = { 16.GB * task.attempt }
        time           = { 4.h * task.attempt }
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }

    // -------------------------------------------------------------------------
    // Empirical Process-Specific Right-Sizing
    // -------------------------------------------------------------------------

    // SAMSEG: Scales with OpenMP threads during EM atlas fitting; 8 CPUs halves runtime to ~10m
    withName: "SEGMENTATION_SAMSEG" {
        cpus   = 8
        memory = { 20.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // MIMOSA: Single-threaded R script (fslr); prevent reserving 4 idle cores in Slurm
    withName: "SEGMENTATION_MIMOSA" {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // WMH-SynthSeg: On HPC GPUs (>=16GB VRAM), executes in ~30s; on CPU path needs 24GB RAM
    withName: "SEGMENTATION_WMH_SYNTHSEG" {
        cpus   = 2
        memory = { (task.ext.gpu ? 16.GB : 24.GB) * task.attempt }
        time   = { (task.ext.gpu ? 1.h : 3.h) * task.attempt }
    }

    // HyperMapp3r: Theano/Python 3.5 requires up to 16.2 GB peak RAM
    withName: "SEGMENTATION_HYPERMAPP3R" {
        cpus   = 4
        memory = { 20.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // LST-AI: Multi-threaded nnU-Net ensemble
    withName: "SEGMENTATION_LST_AI" {
        cpus   = 6
        memory = { 10.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // SynthStrip: Accelerated on GPU when GPU profile active, otherwise 4 CPUs
    withName: "SYNTHSTRIP_T1|SYNTHSTRIP_FLAIR" {
        ext.gpu        = { params.use_gpu }
        cpus           = { task.ext.gpu ? 2 : 4 }
        memory         = { (task.ext.gpu ? 8.GB : 6.GB) * task.attempt }
        time           = { 1.h * task.attempt }
        accelerator    = { task.ext.gpu ? 1 : null }
        clusterOptions = { task.ext.gpu ? (params.cluster_gpu_options ?: '--gres=gpu:1') : null }
    }


    // ANTs N4 and Registrations: Multi-threaded ITK C++
    withName: "N4_T1|N4_FLAIR|REGISTER_FLAIR_TO_T1|REGISTER_T1_TO_BASELINE|REGISTER_BASELINE_TO_MNI" {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // STAPLE Consensus & Longitudinal Harmonization
    withName: "CONSENSUS_STAPLE|HARMONIZATION_STAPLE" {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
