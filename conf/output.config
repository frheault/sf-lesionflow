// =============================================================================
// Published output layout (single source of truth for every publishDir).
//
//   results/
//   ├── pipeline_info/               execution report/timeline/trace, software_versions.yml
//   ├── multiqc/                     cohort_multiqc_report.html
//   └── sub-XX/
//       ├── ses-YY/
//       │   ├── anat/                MNI anatomicals, MNI brain mask, SynthSeg
//       │   ├── lesions/             one _mask/_probseg/_mask.json per algorithm (MNI)
//       │   ├── consensus/           STAPLE probseg / mask / dseg (MNI)
//       │   ├── xfm/                 ANTs transforms
//       │   ├── qc/                  QC tables and images
//       │   ├── multiqc/             session MultiQC report
//       │   ├── preproc/             native preprocessing   (--publish_intermediates)
//       │   └── native/              native lesion outputs  (--publish_native)
//       └── longitudinal/            harmonized masks, tracking CSV, qc/
//
// Names come from lib/OutputNaming.groovy through `saveAs`, so changing them never
// invalidates -resume. Every publishDir uses params.publish_dir_mode (default: symlink --
// results/ then points into work/: copy with --publish_dir_mode copy before cleaning work/).
// =============================================================================

def _naming_file = new File("${projectDir}/lib/OutputNaming.groovy")
if (!_naming_file.exists()) {
    _naming_file = new File("lib/OutputNaming.groovy")
}
OutputNaming = new GroovyClassLoader(getClass().getClassLoader()).parseClass(_naming_file)

process {
    // Nothing is published unless listed below.
    publishDir = [ path: { "${params.output}/.unpublished" }, enabled: false ]

    // ── native preprocessing (preproc/) ───────────────────────────────────────
    withName: 'RESAMPLE_T1|SYNTHSTRIP_T1|CROP_T1_MASK|CROP_T1_RAW|N4_T1|MASK_T1|MASK_T1_PRE_N4' {
        publishDir = [
            path    : { "${params.output}/${meta.subject}/${meta.session}" },
            mode    : params.publish_dir_mode,
            enabled : params.publish_intermediates as boolean,
            saveAs  : { fn -> OutputNaming.preproc(fn, meta, 'T1w') }
        ]
    }
    withName: 'RESAMPLE_FLAIR|SYNTHSTRIP_FLAIR|CROP_FLAIR_MASK|CROP_FLAIR_RAW|N4_FLAIR|MASK_FLAIR|MASK_FLAIR_PRE_N4' {
        publishDir = [
            path    : { "${params.output}/${meta.subject}/${meta.session}" },
            mode    : params.publish_dir_mode,
            enabled : params.publish_intermediates as boolean,
            saveAs  : { fn -> OutputNaming.preproc(fn, meta, 'FLAIR') }
        ]
    }

    // ── transforms (xfm/) ─────────────────────────────────────────────────────
    withName: 'REGISTER_FLAIR_TO_T1' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.registration(fn, meta, 'flair_to_t1', params.template_space) } ]
    }
    withName: 'REGISTER_T1_TO_BASELINE' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.registration(fn, meta, 't1_to_baseline', params.template_space) } ]
    }
    withName: 'REGISTER_BASELINE_TO_MNI' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.registration(fn, meta, 'baseline_to_mni', params.template_space) } ]
    }

    // ── MNI anatomicals (anat/) ───────────────────────────────────────────────
    withName: 'TRANSFORM_T1W_TO_MNI|TRANSFORM_FLAIR_TO_MNI|TRANSFORM_T1W_UNSTRIPPED_TO_MNI|TRANSFORM_FLAIR_UNSTRIPPED_TO_MNI|TRANSFORM_T1_BRAINMASK_TO_MNI|PREPROC_SYNTHSEG' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.anat(fn, meta, params.template_space) } ]
    }

    // ── lesions (lesions/): LESION_FINALIZE already writes the final names ────
    withName: 'LESION_FINALIZE' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}/lesions" }, mode: params.publish_dir_mode ]
    }

    // ── native-space raw algorithm outputs (native/, opt-in) + MARS-WMH's own QC report
    withName: 'SEGMENTATION_LST_AI|SEGMENTATION_TRUENET|SEGMENTATION_BAWIL|SEGMENTATION_MINDGLIDE' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       enabled: params.publish_native as boolean,
                       saveAs: { fn -> OutputNaming.nativeOutput(fn, meta) } ]
    }
    withName: 'SEGMENTATION_MARS_WMH' {
        publishDir = [
            [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
              enabled: params.publish_native as boolean,
              saveAs: { fn -> OutputNaming.nativeOutput(fn, meta) } ],
            [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
              saveAs: { fn -> OutputNaming.marsQc(fn, meta) } ]
        ]
    }

    // ── consensus (consensus/) ────────────────────────────────────────────────
    withName: 'CONSENSUS_STAPLE' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.consensus(fn, meta, params.template_space) } ]
    }

    // ── longitudinal (sub-XX/longitudinal/) ───────────────────────────────────
    withName: 'HARMONIZATION_STAPLE' {
        publishDir = [ path: { "${params.output}/${subject}/longitudinal" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.harmonized(fn, subject, params.template_space) } ]
    }
    withName: '.*QC_PIPELINE:QC_LONGITUDINAL' {
        publishDir = [ path: { "${params.output}/${subject}/longitudinal" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.longitudinalQc(fn, subject) } ]
    }

    // ── session QC (qc/) ──────────────────────────────────────────────────────
    withName: '.*QC_PIPELINE:QC_ENSEMBLE_METRICS|.*QC_PIPELINE:QC_REGISTRATION_.*|.*QC_PIPELINE:QC_LESION_SCREENSHOT' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.sessionQc(fn, meta) } ]
    }

    // ── MultiQC ───────────────────────────────────────────────────────────────
    withName: '.*QC_PIPELINE:MULTIQC_SUBJECT' {
        publishDir = [ path: { "${params.output}/${meta.subject}/${meta.session}/multiqc" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.multiqc(fn, meta.id) } ]
    }
    withName: '.*QC_PIPELINE:MULTIQC_GLOBAL' {
        publishDir = [ path: { "${params.output}/multiqc" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> OutputNaming.multiqc(fn, 'cohort') } ]
    }
}
