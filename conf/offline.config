// =============================================================================
// Offline container overrides
// -----------------------------------------------------------------------------
// All nine sf-lesionflow-specific containers are now published on DockerHub
// under frheault/sf-lesionflow-<algo>:<version>. On a cluster whose compute
// nodes have no internet access (e.g. Alliance Canada), Nextflow's normal
// `apptainer pull docker://...` auto-fetch cannot reach any registry.
//
// Solution: use dockerfiles/build_offline_containers.sh to pre-download every
// image (including the frheault/* ones) into a local directory on a login node
// that has internet access, then point --sif_cache at that directory:
//
//   dockerfiles/build_offline_containers.sh /scratch/$USER/sf-lesionflow_sif
//   # then on the cluster:
//   nextflow run frheault/sf-lesionflow ... \
//       --sif_cache /project/<def-group>/sf-lesionflow_sif \
//       -profile hpc,apptainer,gpu,offline
//
// Since the nine images are now ordinary public DockerHub images, they no
// longer need an explicit override to be found offline: Phase 2 of
// build_offline_containers.sh pulls them into the same --sif_cache dir using
// Nextflow's own apptainer/singularity cacheDir naming convention (see
// nextflow.config), exactly like freesurfer/freesurfer, mgoubran/hypermapper,
// etc. -- Nextflow resolves them automatically from the `container` directive
// already set in modules/local/lesion_segmentation.nf.
//
// The withName blocks below are now only a DEVELOPER OVERRIDE: if you've
// modified one of the nine containers locally and used
// build_offline_containers.sh's Phase 1 (docker-daemon://) to bake it into a
// <algo>.sif WITHOUT pushing to DockerHub first, that .sif takes precedence
// over the public image. If no such .sif exists in --sif_cache (the normal
// case), the block below is a no-op and the process's own public-image
// `container` directive is used, resolved from the cache dir like any other
// public container.
// =============================================================================

def _offline_sif_dir = params.sif_cache ?: (System.getenv('NXF_APPTAINER_CACHEDIR') ?: (System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity_cache"))

// Returns the path to a dev-override .sif if it was built by Phase 1 of
// build_offline_containers.sh, or null if only the public image was pulled
// (Phase 2) -- in which case Nextflow resolves the container on its own.
// `dir` is taken as a parameter (rather than closure-captured) because
// Nextflow's process/withName config DSL does not reliably resolve outer
// local variables referenced from inside a nested function call.
def _devSif(String dir, String sifName) {
    def f = new File("${dir}/${sifName}")
    return f.exists() ? f.path : null
}

process {
    withName: 'SEGMENTATION_LST_AI' {
        def sif = _devSif(_offline_sif_dir, 'lst_ai.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_WMH_SYNTHSEG' {
        def sif = _devSif(_offline_sif_dir, 'wmh_synthseg.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_FAST_OUTLIER' {
        def sif = _devSif(_offline_sif_dir, 'fast_outlier.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_FLAMES' {
        def sif = _devSif(_offline_sif_dir, 'flames.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_TRUENET' {
        def sif = _devSif(_offline_sif_dir, 'truenet.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_BAWIL' {
        def sif = _devSif(_offline_sif_dir, 'bawil.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_MIMOSA' {
        def sif = _devSif(_offline_sif_dir, 'mimosa.sif')
        if (sif) { container = sif }
    }
    withName: 'SEGMENTATION_SHIVAI' {
        def sif = _devSif(_offline_sif_dir, 'shivai.sif')
        if (sif) { container = sif }
    }
    // Split into separate single-name selectors (rather than one
    // 'A|B|C' selector) because Nextflow's config loader warns about an
    // "unknown config attribute" for a multi-name withName selector whose
    // block ends up setting no directive -- which is exactly what happens
    // here in the normal (no dev-override .sif) case.
    withName: 'SEGMENTATION_SEGCSVD' {
        def sif = _devSif(_offline_sif_dir, 'segcsvd.sif')
        if (sif) { container = sif }
    }
    withName: 'CONSENSUS_STAPLE' {
        def sif = _devSif(_offline_sif_dir, 'segcsvd.sif')
        if (sif) { container = sif }
    }
    withName: 'HARMONIZATION_STAPLE' {
        def sif = _devSif(_offline_sif_dir, 'segcsvd.sif')
        if (sif) { container = sif }
    }
}
