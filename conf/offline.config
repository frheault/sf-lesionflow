// =============================================================================
// Offline container overrides
// -----------------------------------------------------------------------------
// Nine of this pipeline's containers only ever existed as local Docker daemon
// images (built via dockerfiles/*, never pushed to a registry): ms_chus/lst_ai,
// ms_chus/wmh_synthseg, ms_chus/fast_outlier, ms_chus/flames, ms_chus/truenet,
// ms_chus/bawil, ms_chus/mimosa, ms_chus/shivai, and segcsvd_rc03. On a cluster
// whose compute nodes have no internet access (e.g. Alliance Canada), Nextflow's
// normal `apptainer pull docker://...` auto-fetch can never reach these images.
//
// bin/build_offline_containers.sh converts each one to a .sif on a machine that
// still has the Docker daemon (built once, e.g. this dev workstation) and names
// them to match the `withName` overrides below. Point `--sif_cache` (or
// `params.sif_cache`) at the directory holding those .sif files, e.g.:
//
//   nextflow run main.nf ... --sif_cache /project/<def-group>/sf-lesionflow_sif -profile hpc,apptainer,gpu,offline
//
// All other containers (freesurfer/freesurfer, mgoubran/hypermapper,
// emorycn2l/emory_robust_wmh, ghcr.io/miac-research/wmh-nnunet, and the
// nf-neuro modules' scilus/scilpy, scilus/scilus, mrtrix3/mrtrix3,
// freesurfer/synthstrip) are public and can be pre-pulled normally on a login
// node (e.g. with nf-neuro's download_pipeline.sh) into the same cache dir.
// =============================================================================

def _offline_sif_dir = params.sif_cache ?: (System.getenv('NXF_APPTAINER_CACHEDIR') ?: (System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity_cache"))

process {
    withName: 'SEGMENTATION_LST_AI' {
        container = "${_offline_sif_dir}/lst_ai.sif"
    }
    withName: 'SEGMENTATION_WMH_SYNTHSEG' {
        container = "${_offline_sif_dir}/wmh_synthseg.sif"
    }
    withName: 'SEGMENTATION_FAST_OUTLIER' {
        container = "${_offline_sif_dir}/fast_outlier.sif"
    }
    withName: 'SEGMENTATION_FLAMES' {
        container = "${_offline_sif_dir}/flames.sif"
    }
    withName: 'SEGMENTATION_TRUENET' {
        container = "${_offline_sif_dir}/truenet.sif"
    }
    withName: 'SEGMENTATION_BAWIL' {
        container = "${_offline_sif_dir}/bawil.sif"
    }
    withName: 'SEGMENTATION_MIMOSA' {
        container = "${_offline_sif_dir}/mimosa.sif"
    }
    withName: 'SEGMENTATION_SHIVAI' {
        container = "${_offline_sif_dir}/shivai.sif"
    }
    withName: 'SEGMENTATION_SEGCSVD|CONSENSUS_STAPLE|HARMONIZATION_STAPLE' {
        container = "${_offline_sif_dir}/segcsvd.sif"
    }
}
